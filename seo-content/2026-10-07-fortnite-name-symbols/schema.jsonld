      "@type": "HowTo",
      "name": "How to put symbols in your Fortnite name",
      "step": [
        {"@type": "HowToStep", "position": 1, "text": "Copy a symbol from the table, or build the name in the Fortnite font generator and add a symbol at each end."},
        {"@type": "HowToStep", "position": 2, "text": "Sign in at epicgames.com in a phone or computer browser and open Account settings."},
        {"@type": "HowToStep", "position": 3, "text": "Click the pencil icon next to your display name."},
        {"@type": "HowToStep", "position": 4, "text": "Paste the name with your symbol, keeping it between 3 and 16 characters."},
        {"@type": "HowToStep", "position": 5, "text": "Confirm the change. If Epic rejects it, swap in a plainer symbol and try again."},
        {"@type": "HowToStep", "position": 6, "text": "Restart Fortnite so the new name loads."}
